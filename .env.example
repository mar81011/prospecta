# Local values are printed by `npx supabase start` (or `npx supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for /api/cron/subscriptions (Vercel Cron sends it as a Bearer token).
CRON_SECRET=change-me

# AI assistant (Claude). Without a key, AI buttons are hidden.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5).
# AI_MODEL=
# Tests only: AI_PROVIDER=fake uses a deterministic offline stand-in.
# AI_PROVIDER=
